{
  "redirects": [
    { "source": "/index.php/id/", "destination": "/", "permanent": true },
    { "source": "/index.php/id", "destination": "/", "permanent": true },
    { "source": "/index.php/id/tentang-kami", "destination": "/tentang-kami.html", "permanent": true },
    { "source": "/index.php/id/pilar-bisnis/kursus-bahasa", "destination": "/kursus-bahasa.html", "permanent": true },
    { "source": "/index.php/id/pilar-bisnis/interpreter", "destination": "/jasa-interpreter.html", "permanent": true },
    { "source": "/index.php/id/pilar-bisnis/translater", "destination": "/jasa-penerjemah.html", "permanent": true },
    { "source": "/index.php/id/kontak-kami", "destination": "/beranda.html#kontak", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/beranda.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
